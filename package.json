{
  "name": "whatsapp-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente de WhatsApp para repuestos usados de auto, integrado a sistema_erp via Supabase.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify-setup.ts",
    "reset-chat": "tsx scripts/reset-conversation.ts",
    "gaps-report": "tsx scripts/gaps-report.ts",
    "limpiar": "tsx scripts/limpiar.ts",
    "verificar-freno": "tsx scripts/verificar-freno.ts",
    "verificar-envio": "tsx scripts/verificar-envio.ts",
    "unificar-chats": "tsx scripts/unificar-chats-duplicados.ts",
    "limpiar-respaldo": "tsx scripts/limpiar-respaldo-sesion.ts",
    "verificar-rafagas": "tsx scripts/verificar-rafagas.ts",
    "limpiar-media": "tsx scripts/limpiar-media-vieja.ts",
    "verificar-recepcion": "tsx scripts/verificar-recepcion.ts"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@hapi/boom": "^10.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
