# Mismo proyecto de Supabase que sistema_erp.
SUPABASE_URL=https://xxxxx.supabase.co
# service_role key -- NUNCA el anon key. Sacala de Project Settings > API en Supabase.
# No subir el .env real a ningun repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Reusa la misma key que ya tiene sistema_erp en su .env (GEMINI_API_KEY).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Cuanto razona el modelo antes de contestar: minimal | low | medium |
# high, u off (default) para no mandar el parametro. MEDIDO: bajarlo no
# ahorra tokens en gemini-3.6-flash y en low ROMPE la salida (el modelo
# escribe su razonamiento adentro de los campos del JSON y el cliente se
# queda sin respuesta). Ver docs/system-prompts.md antes de tocarlo.
#GEMINI_THINKING_LEVEL=off

# Nombre del negocio, se usa en el prompt del redactor.
BUSINESS_NAME=

# Numero personal (codigo de pais + numero, sin '+' ni espacios, ej.
# 593987654321) al que el bot avisa por WhatsApp cuando escala una
# conversacion a un humano.
OWNER_PHONE_NUMBER=

# Score minimo (0-1) de similitud para considerar que un producto fue
# "encontrado". Por debajo de esto se trata como que no existe en catalogo.
MATCH_CONFIDENCE_THRESHOLD=0.3

# Para MOSTRAR una sugerencia al cliente se exige una coincidencia mucho
# más alta que para la ayuda interna del vendedor. Si no la alcanza, una
# persona revisa la solicitud y el bot no ofrece una pieza por parecido.
CATALOG_SUGGESTION_CONFIDENCE_THRESHOLD=0.85

# Poner en false durante pruebas en vivo para que el bot NO guarde
# demandas de stock reales por productos que en realidad no hacen falta
# (el bot sigue respondiendo normal, solo no anota en product_demands).
DEMAND_REGISTRATION_ENABLED=true

# Freno de emergencia del servidor: en true apaga el agente entero sin
# importar lo que diga el ERP. Dejalo en false -- el interruptor normal
# vive en la base (agent_settings) y se maneja desde el ERP.
# Recorda que ademas cada conversacion necesita estar habilitada a mano
# desde la bandeja de WhatsApp (agent_conversations.bot_enabled).
BOT_KILL_SWITCH=false

# intake = el bot junta y confirma los datos. Al terminar busca una
#          coincidencia MUY segura en el catalogo; solo entonces manda foto
#          y precio, sin confirmar stock. Una persona revisa el stock.
# full   = flujo completo: busca en el catalogo y cotiza.
AGENT_MODE=intake

# Guardar los mensajes del history sync de WhatsApp desde esta fecha
# (YYYY-MM-DD), para analisis. Vacio = no importar historial, solo
# registrar lo nuevo. OJO: solo aplica al lote que WhatsApp manda al
# VINCULAR el dispositivo; no se puede pedir mas historial que ese.
HISTORY_IMPORT_SINCE=

# Cuantos chats "arranca" el agente por vuelta (cada 60s) cuando los
# habilitas desde el ERP. Dejalo bajo: mandar mensajes no solicitados en
# rafaga es lo que hizo que WhatsApp restringiera el numero una vez.
PROACTIVE_INTAKE_BATCH_SIZE=1

# Hora (0-23, horario de Ecuador) en la que se manda el resumen diario de
# huecos (busquedas sin resultado + escalamientos) al dueno por WhatsApp.
GAPS_REPORT_HOUR=8

# Carpeta local donde Baileys guarda la sesion de WhatsApp (auth-state).
AUTH_STATE_DIR=./auth_state
# Bucket privado de Supabase Storage donde se respalda esa sesion (ver migracion 0002).
AUTH_BACKUP_BUCKET=agent_whatsapp_session

# trace | debug | info | warn | error | silent
BAILEYS_LOG_LEVEL=warn

# Bucket PUBLICO de Supabase Storage con la media del chat: la foto que
# manda el cliente y lo que el equipo adjunta desde el ERP (migracion
# 0026). Publico porque quien descarga el archivo para enviarlo es
# WhatsApp, y una URL firmada que vence rompe el envio.
CHAT_MEDIA_BUCKET=agent_chat_media

# Guardar en Storage la media que entra por WhatsApp. En false, el mensaje
# se sigue registrando pero sin la foto (el ERP muestra "(foto)" a secas).
# OJO: WhatsApp NO reentrega la media vieja; lo que no se guarde cuando
# llega, se pierde.
CHAT_MEDIA_CAPTURE=true

# Tope por archivo, en MB. Arriba de esto el mensaje se registra igual,
# pero sin el archivo.
#
# El video tiene su propio tope, mas bajo, y no es capricho: se midio el
# consumo real y un video promedia 3,9 MB contra 124 KB de una foto --
# siendo el 3% de los archivos, los videos son el 57% del crecimiento del
# Storage. En repuestos el pedido llega como foto de la pieza o como nota
# de voz, casi nunca como video.
CHAT_MEDIA_MAX_MB=8
CHAT_MEDIA_MAX_VIDEO_MB=3

# A quien puede escribirle el agente. Se aplica en el socket mismo, asi
# que cubre TODOS los caminos de salida (ver src/whatsapp/outboundGuard.ts).
#   blocked  = ningun cliente recibe nada (solo avisos al dueno).
#   erp_only = los clientes solo reciben lo que una persona escribe a mano
#              desde el ERP; el agente no contesta solo.
#   full     = el agente trabaja normal.
# Si falta o esta mal escrita, vale 'blocked': ante la duda, callado.
# Comprobalo con: npm run verificar-freno
OUTBOUND_MODE=blocked
